---
import { readdirSync, readFileSync } from 'node:fs';
import Base from '../layouts/Base.astro';

const OUTPUT_DIR = './tests/gestalt/output';
const files = readdirSync(OUTPUT_DIR).filter(f => f.endsWith('.svg')).sort();
const svgs = files.map(f => {
  const svg = readFileSync(`${OUTPUT_DIR}/${f}`, 'utf8');
  const m = svg.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
  const ar = m ? (parseFloat(m[1]) / parseFloat(m[2])).toFixed(4) : '1.7778';
  return { name: f.replace('.svg', ''), svg, ar };
});
---

<Base title="Gestalt P1 — projection testbench">
  <main style="max-width: 1100px; margin: 0 auto; padding: 2rem 1rem;">
    <nav class="breadcrumb">
      <a href="/">diana@nerd:~$</a>
      <span>/</span>
      <span>gestalt-gallery</span>
    </nav>
    <h1 style="margin-top: 1rem;">Gestalt P1 — projection testbench</h1>
    <p style="color: var(--fg-dim); margin: 1rem 0 2rem;">
      6 fixtures; V1 / V2 / V8 / V16 all green. Each card draws the canvas
      bounds (cyan), the declared margin box (purple dashed) and the content
      bbox centred inside it.
    </p>
    {svgs.map(({name, svg, ar}) => (
      <section style="margin-bottom: 2.5rem;">
        <h2 style="font-size: 1rem; margin-bottom: 0.5rem;">{name}</h2>
        <div class="diagram-frame" style={`--ar: ${ar}`} set:html={svg}></div>
      </section>
    ))}
  </main>
</Base>

<style>
  .diagram-frame {
    border: 1px solid var(--border);
    background: #0a0a0a;
    border-radius: 4px;
    padding: 0;
    display: block;
    line-height: 0;
    /* The bordered frame always matches the SVG's viewBox aspect so no
       letterboxing happens inside the border and the controls (anchored to
       the SVG element edges) land flush with the container. `--ar` is set
       inline per-fixture; width clamps to the smaller of the column or what
       fits under 70vh at this aspect. */
    aspect-ratio: var(--ar);
    width: min(100%, calc(70vh * var(--ar)));
  }
  .diagram-frame :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Overlay the projection bounds for diagnostics. */
  .diagram-frame :global(svg)::after {
    content: '';
  }
</style>
