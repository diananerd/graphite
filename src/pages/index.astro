---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import blogConfig from '../../blog.config.ts';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id));
---

<Base>
  <main>
    <header class="site-header">
      <span class="prompt">{blogConfig.terminal.prompt}</span>
      <span class="cursor">█</span>
    </header>
    {posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ol class="post-list" role="list">
        {posts.map((post) => (
          <li class="post-item">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toISOString().slice(0, 10)}
            </time>
            <a href={`/${post.id}/`}>{post.data.title}</a>
            {post.data.tags && post.data.tags.length > 0 && (
              <span class="post-tags">
                {post.data.tags.map(t => <span class="tag">#{t}</span>)}
              </span>
            )}
          </li>
        ))}
      </ol>
    )}
    {blogConfig.site.socials && blogConfig.site.socials.length > 0 && (
      <footer class="site-footer">
        {blogConfig.site.socials.map(s => (
          <a href={s.href}>{s.label}</a>
        ))}
      </footer>
    )}
  </main>
</Base>

<style>
  .empty {
    color: var(--fg-dim, var(--fg-dim));
    font-size: 0.875rem;
  }
  .site-footer {
    border-top: 1px solid var(--border, #2c2c2a);
    padding-top: 1rem;
    display: flex;
    gap: 1.5ch;
  }
  .site-footer a {
    font-size: 0.875rem;
    color: var(--fg-dim, var(--fg-dim));
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--accent, #8faacc);
  }
</style>
