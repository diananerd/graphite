---
import blogConfig from '../../blog.config.ts';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
}

const {
  title,
  description = blogConfig.site.description,
  ogImage = '/og/home.png',
  type = 'website',
  publishedDate,
} = Astro.props;

const siteTitle = blogConfig.site.name;
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;

const ogImageAbsolute = new URL(ogImage, Astro.site).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={blogConfig.site.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#181818" />
  <link rel="canonical" href={canonicalURL} />

  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={blogConfig.site.author.name} />

  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />

  {type === 'article' && publishedDate && (
    <meta property="article:published_time" content={publishedDate.toISOString()} />
  )}

  <link
    rel="preload"
    href="/fonts/MonaspaceNeonVarVF.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/styles/font-fallback.css" />

  <style is:inline>
    @font-face {
      font-family: 'Monaspace Neon';
      src: url('/fonts/MonaspaceNeonVarVF.woff2') format('woff2-variations'),
           url('/fonts/MonaspaceNeonVarVF.woff2') format('woff2');
      font-weight: 200 800;
      font-style: normal;
      font-display: swap;
    }
    /* Critical CSS — above-the-fold, available before global.css parses */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #181818; --fg: #e0ddd6; --accent: #bf7fff;
      --font: var(--font-stack, 'Monaspace Neon', ui-monospace, monospace);
      --gap: 2rem; --col: 65ch;
    }
    html { font-size: 100%; }
    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--fg);
      padding: var(--gap) 1rem;
      -webkit-font-smoothing: antialiased;
      font-feature-settings: 'calt' 1;
    }
    main { max-width: var(--col); margin: 0 auto; }
    .site-header {
      color: var(--accent);
      padding-bottom: var(--gap);
      border-bottom: 1px solid #2c2c2a;
      font-size: 1rem;
      display: flex; align-items: center; gap: 0.35ch;
    }
  </style>

  <link rel="stylesheet" href="/styles/global.css" />

  <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
</head>
<body>
  <slot />
</body>
</html>
