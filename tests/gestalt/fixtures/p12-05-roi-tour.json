{
  "name": "p12-05-roi-tour",
  "title": "ROI tour — dense system, zoom into each subsystem",
  "ratio": "16:9",
  "margin": 32,
  "nodes": [
    { "id": "client", "shape": "actor",    "label": "Client",  "role": "external" },
    { "id": "lb",     "shape": "rect",     "label": "LB",      "role": "info" },
    { "id": "gw",     "shape": "rect",     "label": "Gateway", "role": "primary" },
    { "id": "auth",   "shape": "hexagon",  "label": "Auth",    "role": "data" },
    { "id": "api1",   "shape": "rect",     "label": "API-1",   "role": "secondary" },
    { "id": "api2",   "shape": "rect",     "label": "API-2",   "role": "secondary" },
    { "id": "api3",   "shape": "rect",     "label": "API-3",   "role": "secondary" },
    { "id": "queue",  "shape": "pill",     "label": "Queue",   "role": "warning" },
    { "id": "w1",     "shape": "round",    "label": "Worker-1","role": "success" },
    { "id": "w2",     "shape": "round",    "label": "Worker-2","role": "success" },
    { "id": "w3",     "shape": "round",    "label": "Worker-3","role": "success" },
    { "id": "db",     "shape": "cylinder", "label": "DB",      "role": "data" },
    { "id": "audit",  "shape": "rect",     "label": "Audit",   "role": "info" }
  ],
  "edges": [
    { "from": "client", "to": "lb",   "style": { "head": "arrow" } },
    { "from": "lb",     "to": "gw",   "style": { "head": "arrow" } },
    { "from": "gw",     "to": "auth", "style": { "head": "arrow" }, "role": "data" },
    { "from": "gw",     "to": "api1", "style": { "head": "arrow" } },
    { "from": "gw",     "to": "api2", "style": { "head": "arrow" } },
    { "from": "gw",     "to": "api3", "style": { "head": "arrow" } },
    { "from": "api1",   "to": "queue","style": { "head": "arrow" }, "role": "warning" },
    { "from": "api2",   "to": "queue","style": { "head": "arrow" }, "role": "warning" },
    { "from": "api3",   "to": "queue","style": { "head": "arrow" }, "role": "warning" },
    { "from": "queue",  "to": "w1",   "style": { "head": "arrow" } },
    { "from": "queue",  "to": "w2",   "style": { "head": "arrow" } },
    { "from": "queue",  "to": "w3",   "style": { "head": "arrow" } },
    { "from": "w1",     "to": "db",   "style": { "head": "arrow", "line": "double" }, "role": "data" },
    { "from": "w2",     "to": "db",   "style": { "head": "arrow", "line": "double" }, "role": "data" },
    { "from": "w3",     "to": "db",   "style": { "head": "arrow", "line": "double" }, "role": "data" },
    { "from": "gw",     "to": "audit","style": { "head": "diamond", "line": "dotted" }, "role": "info" }
  ],
  "steps": [
    { "id": "overview", "caption": "Overview — 13 nodes, 4 subsystems",
      "show": "*", "camera": "*" },
    { "id": "ingress",  "caption": "Ingress — Client → LB → Gateway",
      "dim": ["auth","api1","api2","api3","queue","w1","w2","w3","db","audit"],
      "camera": ["client", "lb", "gw"] },
    { "id": "api-tier", "caption": "API tier — Gateway distributes to 3 API shards",
      "undim": ["api1","api2","api3"], "activate": ["gw"],
      "dim": ["client","lb"],
      "camera": ["gw", "api1", "api2", "api3"] },
    { "id": "queue",    "caption": "Async fanout — APIs push to the queue",
      "deactivate": ["gw"], "dim": ["gw"],
      "undim": ["queue"], "activate": ["queue"],
      "camera": ["api1", "api2", "api3", "queue"] },
    { "id": "workers",  "caption": "Workers — pool processes the queue",
      "deactivate": ["queue"],
      "undim": ["w1","w2","w3"], "activate": ["w1","w2","w3"],
      "camera": ["queue", "w1", "w2", "w3"] },
    { "id": "persist",  "caption": "Persistence — workers write to the replicated DB",
      "deactivate": ["w1","w2","w3"],
      "undim": ["db"], "emphasize": ["db"],
      "camera": ["w1", "w2", "w3", "db"] },
    { "id": "audit",    "caption": "Audit channel — Gateway also writes diagnostic telemetry",
      "undim": ["audit","gw"], "activate": ["audit"],
      "camera": ["gw", "audit"] },
    { "id": "final",    "caption": "Full picture — pan/zoom freely to explore",
      "deactivate": ["audit"], "undim": "*", "camera": "*", "duration": 1000 }
  ]
}
