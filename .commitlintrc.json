{
  "rules": {
    "type-enum": [2, "always", [
      "post",
      "feat",
      "fix",
      "style",
      "docs",
      "build",
      "ci",
      "chore",
      "refactor",
      "revert"
    ]],
    "type-case": [2, "always", "lower-case"],
    "subject-min-length": [2, "always", 5],
    "subject-max-length": [2, "always", 72],
    "subject-empty": [2, "never"]
  }
}
